<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />
  <!-- v323：二改的本地文件浏览器需要它。官方 3.1 没有这个功能，合并时整条声明被覆盖，
       导致设置页里“允许访问所有文件”开关不可用、点进去返回后仍判定未授权 → 循环弹窗。 -->
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- v1015：工作区终端「不让 CPU 睡」所需（WorkspaceBoostManager.acquireWakeLock 申请）。
       合并上游时这行极易被整覆盖：丢了不报错也不崩，只是终端跑长任务会被系统休眠打断。
       由 V1015ManifestGuardTest 钉住。 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />

  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera.autofocus"
    android:required="false" />

  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- 用于解析屏幕使用时间里各 App 的名称(可见性受 Android 11+ 包可见性限制) -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- 用于识别桌面 launcher 以便在屏幕使用时间中排除 -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application
    android:name=".RikkaHubApp"
    android:largeHeap="true"
    android:allowBackup="true"
    android:appCategory="productivity"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher_v261"
    android:roundIcon="@mipmap/ic_launcher_v261"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Rikkahub"
    android:usesCleartextTraffic="true"
    tools:targetApi="33">
    <activity
      android:name=".ui.activity.SafeModeActivity"
      android:exported="false"
      android:label="@string/title_activity_safe_mode"
      android:theme="@style/Theme.Rikkahub" />
    <!-- v1015：下面两块在合并 3.1.0 时被整覆盖丢掉过（类文件一直在、注册没了）。
         症状：账号登录点「去授权」后浏览器回跳 rikkahub://codex|gemini/oauth 无人承接，
         界面永远停在等待授权 = 用户报过的「登录卡死」。由 V1015ManifestGuardTest 钉住。 -->
    <!-- v274：官方账号 OAuth 登录的浏览器回跳页（照搬 ExTV；scheme 固定 rikkahub 是
         OAuth client 注册的 redirect_uri 约定，不能改成我们自己的 rikkahubmod） -->
    <activity
      android:name=".ui.activity.CodexOAuthRedirectActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:host="codex"
          android:path="/oauth"
          android:scheme="rikkahub" />
      </intent-filter>
    </activity>
    <activity
      android:name=".ui.activity.GeminiOAuthRedirectActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:host="gemini"
          android:path="/oauth"
          android:scheme="rikkahub" />
      </intent-filter>
    </activity>

    <!-- v1016：Gemini 网页版「一键登录」页（应用内登录 + 抓 Cookie）。
         这条注册是硬红线：合并官方时整覆盖 Manifest 会把它抹掉，类文件还在、页面起不来，
         表现是点「一键登录」报 Unable to find explicit activity class ——
         与 v1015 抓到的两个 OAuth 回跳页丢失是同一族事故，守卫见 V1016GeminiWebLoginGuardTest。 -->
    <activity
      android:name=".ui.activity.GeminiWebLoginActivity"
      android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density"
      android:exported="false"
      android:label="登录 Google（Gemini 网页版）"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize" />

    <activity
      android:name=".RouteActivity"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:exported="true"
      android:importantForAutofill="noExcludeDescendants"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>

      <intent-filter>
        <action android:name="me.rerere.rikkahub.action.TRANSLATE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <intent-filter>
        <action android:name="me.rerere.rikkahub.action.MEDIA_CREATION" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity>
    <activity
      android:name=".ui.activity.ShortcutHandlerActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />

        <data
          android:host="shortcut"
          android:scheme="rikkahubmod" />  <!-- v1015：与 res/xml/shortcuts.xml 的 data 必须一致，改回官方值会让快捷方式匹配不到本应用（也避免与官方 App 抢 intent） -->
      </intent-filter>
    </activity>
    <service
      android:name=".service.OfficialTransferService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="resumable official workspace transfer with progress notification" />
    </service>


    <service
      android:name=".service.ChatGenerationForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <service
      android:name=".service.MediaCreationForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <service
      android:name=".service.MemoryDreamForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <service
      android:name=".service.WebServerService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="local web server for LLM chat UI" />
    </service>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
    <provider
      android:name=".service.WorkspaceDocumentsProvider"
      android:authorities="${applicationId}.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>

</manifest>
